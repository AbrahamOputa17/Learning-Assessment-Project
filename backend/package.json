{
  "name": "learning-assessment-backend",
  "version": "1.0.0",
  "description": "Backend for the Learning Assessment System",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "db:init": "psql -U postgres -d learning_assessment -f src/database/schema.sql",
